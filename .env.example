# Copy to .env and fill in. .env is gitignored; never commit it.
#
# Every line needs a NAME=value. A bare value on its own line sets nothing —
# the loader will tell you so rather than starting up as though it worked.

# --- Model provider -------------------------------------------------------
# Enables runtime route discovery. Without any provider configured the system
# is cache-only: it replays verified skills and honestly refuses anything else.
ANTHROPIC_API_KEY=sk-ant-...

# Identity-linked keys only. Such a key is not scoped to one workspace, so the
# API cannot infer which one a request acts in and refuses the call outright.
# A plain workspace-scoped key does not need this.
# OMNIBRIDGE_WORKSPACE_ID=wrkspc_...

# --- Google Gemini --------------------------------------------------------
# Needs the optional extra:  pip install -e ".[gemini]"
# GEMINI_API_KEY=...

# Which provider answers discovery. Required whenever more than one is
# configured — selection is never implicit. See docs/PROVIDERS.md.
# OMNIBRIDGE_PROVIDER=gemini

# Override the provider's default model.
# Examples: claude-opus-5, gemini-2.5-pro
# OMNIBRIDGE_MODEL=claude-opus-5

# --- Logging --------------------------------------------------------------
# quiet  = panels only
# normal = step-by-step trail of what each stage actually did (default)
# debug  = adds full prompts, model findings and payloads
# OMNIBRIDGE_LOG=debug

# --- Behaviour ------------------------------------------------------------
# Kill switch: discovery never reaches a model, cache-only.
# OMNIBRIDGE_DISABLE_AGENT=1

# Discovery retry ceiling (default 3).
# OMNIBRIDGE_MAX_RETRIES=3

# Documentation hosts the model may read, comma-separated. Narrowing this
# narrows what can be cited as evidence for a router address.
# OMNIBRIDGE_ALLOWED_DOMAINS=docs.circle.com,docs.across.to

# Skip .env loading entirely.
# OMNIBRIDGE_NO_DOTENV=1

# --- Tests ----------------------------------------------------------------
# Tests that call a paid API are off unless this is set. Deliberately not keyed
# off the presence of a key: this file is loaded automatically, and a configured
# checkout should not start billing an account just by running the suite.
# OMNIBRIDGE_LIVE_TESTS=1
